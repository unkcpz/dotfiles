set $mod Mod1
set $term kitty
set $browser firefox
set $bg_image $HOME/.config/wallpaper/rick-and-morty-background.jpg
set $xremap $HOME/.config/xremap.yml
set $power_menu $HOME/.config/bin/power-menu.sh
set $lock swaylock -fF -i $bg_image

# In order for XDG_DESKTOP service to start
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE
exec systemctl --user start xdg-desktop-portal xdg-desktop-portal-wlr


# dpms management
exec_always swayidle -w \
  timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' \
  timeout 800 '$lock' \
  timeout 1000 'systemctl suspend' \
  before-sleep '$lock'

# layout
default_border none
default_floating_border none
gaps inner 4
gaps outer 8
smart_gaps on
client.focused #7ec5ff #7ec5ff #1e1e2e #7ec5ff #7ec5ff
default_border pixel 3

# devices
input type:touchpad {
  tap enabled
  drag enabled
  drag_lock enabled
  natural_scroll enabled
  dwt enabled 
  middle_emulation enabled 
  pointer_accel 0.3
}

input type:keyboard {
    xkb_layout us
    xkb_variant dvorak-alt-intl
    xkb_options eurosign:e,ctrl:swapcaps
}

# startup
exec $browser
exec sleep 5; systemctl --user start kanshi.service
exec swaybg -i $bg_image -m fill
exec nm-applet
exec wlsunset -l 47.37 -L 8.55 -t 3000 # zurich 47.37/8.55
exec waybar > ~/.cache/waybar.log 2>&1
exec xremap $xremap

output * bg $bg_image fill
output eDP-1 scale 1.0

# --- keybinding
bindsym $mod+Return exec $term
bindsym $mod+Shift+c kill
bindsym $mod+Shift+q exec $HOME/.config/bin/power-menu.sh
bindsym $mod+r exec wofi --show run --prompt "Run:" | xargs swaymsg exec --
bindsym $mod+d exec wofi --show drun --style $HOME/.config/wofi/wofi-drun-style.css
bindsym $mod+Shift+a exec makoctl dismiss
bindsym XF86SelectiveScreenshot exec slurp | grim -g - - | tee ~/Pictures/$(date +%s).png | wl-copy
bindsym XF86Display exec ~/.config/bin/reset-displays.sh

# Toggle touchpad with F11
bindsym F11 exec $HOME/.bin/toggle-touchpad.sh

# Lock screen
bindsym $mod+Shift+n exec $lock

# toggle swaybar
bindsym $mod+Shift+b exec "pkill -USR1 waybar"


# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move windows
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# grow/shrink window width
bindsym $mod+equal resize grow width 10px
bindsym $mod+minus resize shrink width 10px


# Split orientation
bindsym $mod+v split v
bindsym $mod+Shift+v split h

# Toggle floating
bindsym $mod+Shift+space floating toggle

# Fullscreen
bindsym $mod+Shift+f fullscreen toggle

# Workspace switching
bindsym $mod+1 workspace "1: www"
bindsym $mod+2 workspace "2:>"
bindsym $mod+3 workspace "3:>"
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace "7: MAIL"
bindsym $mod+8 workspace "8: AUX-0"
bindsym $mod+9 workspace "9: AUX-1"
bindsym $mod+0 workspace "0: AUX-2"

# Move container to workspace
bindsym $mod+Shift+1 move container to workspace "1: www"
bindsym $mod+Shift+2 move container to workspace "2:>"
bindsym $mod+Shift+3 move container to workspace "3:>"
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace "7: MAIL"
bindsym $mod+Shift+8 move container to workspace "8: AUX-0"
bindsym $mod+Shift+9 move container to workspace "9: AUX-1"
bindsym $mod+Shift+0 move container to workspace "0: AUX-2"

# Move focused window to another output

bindsym $mod+Shift+Left  move window to output left
bindsym $mod+Shift+Right move window to output right

# Brightness (using brightnessctl)
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%

# Volume
bindsym XF86AudioRaiseVolume exec 'pactl set-sink-volume @DEFAULT_SINK@ +1%'
bindsym XF86AudioLowerVolume exec 'pactl set-sink-volume @DEFAULT_SINK@ -1%'
bindsym XF86AudioMute exec 'pactl set-sink-mute @DEFAULT_SINK@ toggle'


### === Floating Windows Rules (Optional) === ###
for_window [class="^confirm$"] floating enable
for_window [class="^dialog$"] floating enable
for_window [title="^Authentication Required$"] floating enable
for_window [app_id="wdisplays"] floating enable
