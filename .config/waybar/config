{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock", "tray"],
  "modules-right": ["cpu", "memory", "pulseaudio", "backlight", "network", "battery", "custom/pacman"],

  "clock": {
    "format": "   {:%a %b %d %H:%M}"
  },

  "pulseaudio": {
    "format": "   {volume}%",
    "format-muted": "Muted"
  },

  "network": {
    "format-wifi": "   {signalStrength}%",
    "format-ethernet": "eth: {ifname}",
    "format-disconnected": " Disconnected"
  },

  "battery": {
    "format": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "memory": {
    "interval": 5,
    "format": "{used:0.1f}G/{total:0.1f}G {0}%",
  },

  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],  // low, medium, high
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },

  "cpu": {
    "format": "{icon}  {usage}%",
    "format-icons": ["󰍛", "󱃊", "󰓅", "󰓅"],

    "tooltip": true,
    "tooltip-format": "{name}:  {usage}%  •  freq {freq} GHz",

    "states": {
      "warning": 70,
      "critical": 90
    },

    "interval": 2
  },

  "tray": {
    "icon-size": 10,
    "spacing": 10
  },

  "custom/pacman": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/pacman-updates.sh",
    "interval": 1800,
    "return-type": "json"
  }

}

